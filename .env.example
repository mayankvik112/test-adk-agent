# Google Cloud project / location the agent runs in.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-west1
GOOGLE_GENAI_USE_VERTEXAI=True

# Gemini models used by the root agent and the datastore-search sub-agent.
ROOT_AGENT_MODEL=gemini-2.5-flash
SEARCH_AGENT_MODEL=gemini-2.5-flash

# Gemini Enterprise Data Store populated by the BigQuery connector
# (see deployment/setup_bigquery_connector.sh). Format:
# projects/<PROJECT_ID>/locations/<LOCATION>/collections/default_collection/dataStores/<DATASTORE_ID>
AEROSPACE_DEFECTS_DATASTORE_ID=projects/your-project-id/locations/global/collections/default_collection/dataStores/aerospace-defects-datastore

# Live BigQuery table backing the same dataset (queried via 3-legged OAuth).
BIGQUERY_PROJECT_ID=your-project-id
BIGQUERY_DATASET=aerospace_quality
BIGQUERY_TABLE=aircraft_defects

# Agent Identity 3-legged OAuth auth provider
# (see deployment/setup_auth_provider.sh).
BIGQUERY_AUTH_PROVIDER_NAME=aerospace-bigquery-3lo-authprovider
# Only used for local `adk web` / custom frontend dev; Gemini Enterprise
# handles the consent redirect itself in production.
BIGQUERY_OAUTH_CONTINUE_URI=http://127.0.0.1:8501/validateUserId

# Public URL of this A2A server once deployed (Cloud Run / GKE), used to
# build the AgentCard's `url` field and for Gemini Enterprise registration.
AGENT_PUBLIC_URL=https://aerospace-quality-reliability-agent-REPLACE.a.run.app
